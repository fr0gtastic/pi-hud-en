{
  "name": "@fr0gtastic/pi-hud-en",
  "version": "0.1.0",
  "description": "English fork of Rana, a desktop pet that shows Pi Coding Agent status above your desktop",
  "author": {
    "name": "fr0gtastic",
    "email": "103203625+fr0gtastic@users.noreply.github.com",
    "url": "https://github.com/fr0gtastic"
  },
  "repository": { "type": "git", "url": "git+https://github.com/fr0gtastic/pi-hud-en.git" },
  "keywords": ["pi-package", "pi-extension", "pi", "desktop-pet", "desktop-companion", "hud", "floating-status", "wsl", "windows", "pyside6", "english", "translation", "i18n"],
  "license": "MIT",
  "homepage": "https://github.com/fr0gtastic/pi-hud-en#readme",
  "bugs": { "url": "https://github.com/fr0gtastic/pi-hud-en/issues" },
